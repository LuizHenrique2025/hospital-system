									"key": "token",
									"value": "{{accessToken}}",
									"type": "string"
								}
							]
						},
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/users/:id",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"users",
								":id"
							],
							"variable": [
								{
									"key": "id",
									"value": "USER_ID_AQUI",
									"description": "ID do usuário (UUID)"
								}
							]
						},
						"description": "Busca um usuário específico por ID.\n\n**Permissão:** ADMIN ou MEDICO\n\n**Nota:** Substitua `:id` pelo UUID do usuário"
					},
					"response": []
				},
