{
	"info": {
		"_postman_id": "hospital-system-api-2026",
		"name": "Hospital System API",
		"description": "Collection completa para testar a API do Sistema Hospitalar",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"item": [
		{
			"name": "Auth",
			"item": [
				{
					"name": "Register (Registrar Usuário)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"// Salvar o token automaticamente se o registro for bem-sucedido",
									"if (pm.response.code === 201) {",
									"    console.log('✅ Usuário registrado com sucesso');",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"name\": \"João Silva\",\n  \"email\": \"joao@example.com\",\n  \"password\": \"senha123\",\n  \"role\": \"ATENDENTE\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/auth/register",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"auth",
								"register"
							]
						},
						"description": "Registra um novo usuário no sistema.\n\n**Roles disponíveis:**\n- ADMIN\n- MEDICO\n- ENFERMEIRO\n- ATENDENTE"
					},
					"response": []
				},
				{
					"name": "Login",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"// Salvar o token JWT automaticamente após login",
									"if (pm.response.code === 200) {",
									"    var jsonData = pm.response.json();",
									"    pm.collectionVariables.set('accessToken', jsonData.access_token);",
									"    console.log('✅ Login realizado! Token salvo:', jsonData.access_token.substring(0, 20) + '...');",
									"    console.log('✅ Agora você pode usar o endpoint Get Profile!');",
									"} else {",
									"    console.error('❌ Erro no login:', pm.response.json());",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"email\": \"joao@example.com\",\n  \"password\": \"senha123\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/auth/login",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"auth",
								"login"
							]
						},
						"description": "Faz login e retorna um token JWT.\n\nO token será salvo automaticamente na variável `accessToken`."
					},
					"response": []
				},
				{
					"name": "Get Profile (Perfil)",
					"event": [
						{
							"listen": "prerequest",
							"script": {
								"exec": [
									"// Debug: verificar se o token existe",
									"const token = pm.collectionVariables.get('accessToken');",
									"if (!token || token === '') {",
									"    console.error('❌ Token não encontrado! Faça login primeiro.');",
									"    console.log('📌 Vá em: Auth > Login e faça login antes de usar este endpoint.');",
									"} else {",
									"    console.log('✅ Token encontrado:', token.substring(0, 20) + '...');",
									"}"
								],
								"type": "text/javascript"
							}
						},
						{
							"listen": "test",
							"script": {
								"exec": [
									"if (pm.response.code === 200) {",
									"    console.log('✅ Perfil obtido com sucesso!');",
									"} else if (pm.response.code === 401) {",
									"    console.error('❌ Erro 401: Token inválido ou expirado');",
									"    console.log('💡 Solução: Faça login novamente em Auth > Login');",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [
								{
									"key": "token",
									"value": "{{accessToken}}",
									"type": "string"
								}
							]
						},
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/auth/profile",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"auth",
								"profile"
							]
						},
						"description": "Retorna o perfil do usuário autenticado.\n\n**Requer autenticação:** Bearer Token"
					},
					"response": []
				}
			],
			"description": "Endpoints de autenticação"
		},
		{
			"name": "Users",
