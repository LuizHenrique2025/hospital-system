						"description": "Cria um novo usuário.\n\n**Permissão:** Apenas ADMIN\n\n**Roles disponíveis:**\n- ADMIN\n- MEDICO\n- ENFERMEIRO\n- ATENDENTE"
					},
					"response": []
				},
				{
					"name": "Get All Users (Listar Usuários)",
