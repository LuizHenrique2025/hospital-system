								{
									"key": "token",
									"value": "{{accessToken}}",
									"type": "string"
								}
							]
						},
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/users?page=1&limit=10",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"users"
							],
							"query": [
								{
									"key": "page",
									"value": "1",
									"description": "Número da página (padrão: 1)"
								},
								{
									"key": "limit",
									"value": "10",
									"description": "Itens por página (padrão: 10)"
								}
							]
						},
						"description": "Lista todos os usuários com paginação.\n\n**Permissão:** ADMIN ou MEDICO"
					},
					"response": []
				},
				{
					"name": "Get User By ID (Buscar por ID)",
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [
