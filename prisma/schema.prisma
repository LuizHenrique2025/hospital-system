generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  MEDICO
  ENFERMEIRO
  ATENDENTE
  FARMACIA
  ESTOQUE
  FATURAMENTO
}

enum Gender {
  MASCULINO
  FEMININO
  OUTRO
}

enum BloodType {
  A_POSITIVO
  A_NEGATIVO
  B_POSITIVO
  B_NEGATIVO
  AB_POSITIVO
  AB_NEGATIVO
  O_POSITIVO
  O_NEGATIVO
}

enum PatientStatus {
  ACTIVE
  BLOCKED
  INACTIVE
}

enum AppointmentStatus {
  AGENDADA
  CONFIRMADA
  REALIZADA
  CANCELADA
  NAO_COMPARECEU
}

enum AppointmentType {
  PRIMEIRA_CONSULTA
  RETORNO
  URGENCIA
  EXAME
}

enum CommunicationType {
  UPDATE
  NOTICE
  HOLIDAY
}

enum InternalMessagePriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum ProcedureType {
  PROCEDURE
  LAB_EXAM
  IMAGE_EXAM
  CONSULTATION
  SURGERY
  ROOM_FEE
  PACKAGE
}

enum ExamOrderStatus {
  REQUESTED
  AUTHORIZATION_PENDING
  AUTHORIZED
  IN_PROGRESS
  RESULT_READY
  CANCELED
}

enum PricingTableType {
  CBHPM
  AGREEMENT
  OWN
  OPERATIONAL_FEE
  MATERIAL_MEDICATION
}

model User {
  id        String   @id @default(uuid())
  name      String
  username  String   @unique
  email     String   @unique
  password  String
  role      Role     @default(ATENDENTE)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  doctor                   Doctor?
  nurse                    Nurse?
  sentInternalMessages     InternalMessage[] @relation("SentInternalMessages")
  receivedInternalMessages InternalMessage[] @relation("ReceivedInternalMessages")
}

model Patient {
  id               String        @id @default(uuid())
  name             String
  cpf              String        @unique
  rg               String?
  birthDate        DateTime
  gender           Gender
  bloodType        BloodType?
  phone            String
  email            String?
  address          String?
  city             String?
  state            String?
  zipCode          String?
  emergencyContact String?
  emergencyPhone   String?
  allergies        String?
  medicalHistory   String?
  status           PatientStatus @default(ACTIVE)
  blockReason      String?
  documents        String[]      @default([])
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  appointments Appointment[]
  examOrders   ExamOrder[]

  @@map("patients")
}

model Doctor {
  id          String   @id @default(uuid())
  userId      String   @unique
  crm         String   @unique
  crmUf       String
  sectorId    String?
  specialties String[]
  phone       String?
  address     String?
  city        String?
  state       String?
  zipCode     String?
  documents   String[] @default([])
  bio         String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  sector       Sector?       @relation(fields: [sectorId], references: [id], onDelete: SetNull)
  appointments Appointment[]
  examOrders   ExamOrder[]

  @@map("doctors")
}

model Nurse {
  id        String   @id @default(uuid())
  userId    String   @unique
  coren     String   @unique
  corenUf   String
  sectorId  String?
  shift     String?
  phone     String?
  address   String?
  city      String?
  state     String?
  zipCode   String?
  documents String[] @default([])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  sector Sector? @relation(fields: [sectorId], references: [id], onDelete: SetNull)

  @@map("nurses")
}

model Sector {
  id          String   @id @default(uuid())
  name        String   @unique
  code        String   @unique
  description String?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  doctors Doctor[]
  nurses  Nurse[]

  @@map("sectors")
}

model Appointment {
  id              String            @id @default(uuid())
  patientId       String
  doctorId        String
  appointmentDate DateTime
  status          AppointmentStatus @default(AGENDADA)
  type            AppointmentType   @default(PRIMEIRA_CONSULTA)
  notes           String?
  diagnosis       String?
  prescription    String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  patient    Patient     @relation(fields: [patientId], references: [id], onDelete: Cascade)
  doctor     Doctor      @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  examOrders ExamOrder[]

  @@map("appointments")
}

model CommunicationEntry {
  id          String            @id @default(uuid())
  type        CommunicationType
  tag         String?
  title       String
  description String
  dateLabel   String?
  active      Boolean           @default(true)
  publishAt   DateTime          @default(now())
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@unique([type, title])
  @@map("communication_entries")
}

model InternalEmail {
  id        String   @id @default(uuid())
  sender    String
  subject   String
  preview   String
  body      String?
  timeLabel String?
  unread    Boolean  @default(true)
  active    Boolean  @default(true)
  sentAt    DateTime @default(now())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([sender, subject])
  @@map("internal_emails")
}

model InternalMessage {
  id                  String                  @id @default(uuid())
  senderId            String
  recipientId         String
  subject             String
  body                String
  priority            InternalMessagePriority @default(NORMAL)
  readAt              DateTime?
  archivedBySender    Boolean                 @default(false)
  archivedByRecipient Boolean                 @default(false)
  deletedBySender     Boolean                 @default(false)
  deletedByRecipient  Boolean                 @default(false)
  createdAt           DateTime                @default(now())
  updatedAt           DateTime                @updatedAt

  sender    User @relation("SentInternalMessages", fields: [senderId], references: [id])
  recipient User @relation("ReceivedInternalMessages", fields: [recipientId], references: [id])

  @@index([recipientId, createdAt])
  @@index([senderId, createdAt])
  @@index([recipientId, readAt])
  @@map("internal_messages")
}

model HealthInsuranceProvider {
  id        String   @id @default(uuid())
  name      String   @unique
  code      String   @unique
  active    Boolean  @default(true)
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  pricingRules AgreementPricingRule[]

  @@map("health_insurance_providers")
}

model Procedure {
  id                    String           @id @default(uuid())
  code                  String           @unique
  description           String
  type                  ProcedureType    @default(PROCEDURE)
  tableCode             String?
  groupName             String?
  unit                  String?
  referencePriceCents   Int?
  requiresAuthorization Boolean          @default(false)
  requiresReport        Boolean          @default(false)
  billable              Boolean          @default(true)
  active                Boolean          @default(true)
  notes                 String?
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt
  examOrderItems        ExamOrderItem[]
  prices                ProcedurePrice[]

  @@map("procedures")
}

model PricingTable {
  id          String           @id @default(uuid())
  name        String
  type        PricingTableType @default(OWN)
  year        Int?
  code        String?
  description String?
  active      Boolean          @default(true)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  prices         ProcedurePrice[]
  agreementRules AgreementPricingRule[]

  @@unique([name, year])
  @@map("pricing_tables")
}

model AgreementPricingRule {
  id                    String    @id @default(uuid())
  providerId            String
  pricingTableId        String
  multiplierBasisPoints Int       @default(10000)
  requiresAuthorization Boolean   @default(false)
  active                Boolean   @default(true)
  validFrom             DateTime?
  validTo               DateTime?
  notes                 String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  provider     HealthInsuranceProvider @relation(fields: [providerId], references: [id], onDelete: Cascade)
  pricingTable PricingTable            @relation(fields: [pricingTableId], references: [id], onDelete: Restrict)

  @@unique([providerId, pricingTableId])
  @@index([providerId, active])
  @@index([pricingTableId])
  @@map("agreement_pricing_rules")
}

model ProcedurePrice {
  id                   String    @id @default(uuid())
  procedureId          String
  pricingTableId       String
  priceCents           Int
  operationalCostCents Int?
  billingUnit          String?
  effectiveFrom        DateTime?
  effectiveTo          DateTime?
  active               Boolean   @default(true)
  notes                String?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  procedure    Procedure    @relation(fields: [procedureId], references: [id], onDelete: Cascade)
  pricingTable PricingTable @relation(fields: [pricingTableId], references: [id], onDelete: Cascade)

  @@unique([procedureId, pricingTableId])
  @@map("procedure_prices")
}

model CbhpmProcedure {
  id                         String   @id @default(uuid())
  codigo                     String
  procedimento               String
  porte                      String?
  fracaoPorte                Decimal? @db.Decimal(10, 4)
  valorPorteCents            Int?
  totalPorteCents            Int?
  incidencias                String?
  filme                      Decimal? @db.Decimal(10, 4)
  totalFilmeCents            Int?
  uco                        Decimal? @db.Decimal(10, 4)
  totalUcoCents              Int?
  porteAnestesico            String?
  valorPorteAnestesicoCents  Int?
  totalPorteAnestesicoCents  Int?
  numeroAuxiliares           Int?
  totalAuxiliaresCents       Int?
  totalPrimeiroAuxiliarCents Int?
  totalSegundoAuxiliarCents  Int?
  totalTerceiroAuxiliarCents Int?
  totalQuartoAuxiliarCents   Int?
  adicionaisCents            Int?
  subtotalCents              Int?
  editionYear                Int
  sourceFile                 String?
  importedAt                 DateTime @default(now())
  createdAt                  DateTime @default(now())
  updatedAt                  DateTime @updatedAt

  @@unique([codigo, editionYear])
  @@index([editionYear])
  @@index([sourceFile])
  @@map("cbhpm_procedures")
}

model ExamOrder {
  id                 String          @id @default(uuid())
  patientId          String
  requesterDoctorId  String?
  appointmentId      String?
  status             ExamOrderStatus @default(REQUESTED)
  priority           String?
  clinicalIndication String?
  notes              String?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  patient         Patient         @relation(fields: [patientId], references: [id], onDelete: Cascade)
  requesterDoctor Doctor?         @relation(fields: [requesterDoctorId], references: [id], onDelete: SetNull)
  appointment     Appointment?    @relation(fields: [appointmentId], references: [id], onDelete: SetNull)
  items           ExamOrderItem[]

  @@map("exam_orders")
}

model ExamOrderItem {
  id          String          @id @default(uuid())
  examOrderId String
  procedureId String
  quantity    Int             @default(1)
  status      ExamOrderStatus @default(REQUESTED)
  notes       String?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  examOrder ExamOrder @relation(fields: [examOrderId], references: [id], onDelete: Cascade)
  procedure Procedure @relation(fields: [procedureId], references: [id], onDelete: Restrict)

  @@unique([examOrderId, procedureId])
  @@map("exam_order_items")
}
