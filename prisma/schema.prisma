generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  MEDICO
  ENFERMEIRO
  ATENDENTE
  FARMACIA
  ESTOQUE
  FATURAMENTO
}

enum Gender {
  MASCULINO
  FEMININO
  OUTRO
}

enum BloodType {
  A_POSITIVO
  A_NEGATIVO
  B_POSITIVO
  B_NEGATIVO
  AB_POSITIVO
  AB_NEGATIVO
  O_POSITIVO
  O_NEGATIVO
}

enum PatientStatus {
  ACTIVE
  BLOCKED
  INACTIVE
}

enum AppointmentStatus {
  AGENDADA
  CONFIRMADA
  REALIZADA
  CANCELADA
  NAO_COMPARECEU
}

enum AppointmentType {
  PRIMEIRA_CONSULTA
  RETORNO
  URGENCIA
  EXAME
}

enum CommunicationType {
  UPDATE
  NOTICE
  HOLIDAY
}

model User {
  id        String   @id @default(uuid())
  name      String
  username  String   @unique
  email     String   @unique
  password  String
  role      Role     @default(ATENDENTE)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  doctor Doctor?
  nurse  Nurse?
}

model Patient {
  id               String     @id @default(uuid())
  name             String
  cpf              String     @unique
  rg               String?
  birthDate        DateTime
  gender           Gender
  bloodType        BloodType?
  phone            String
  email            String?
  address          String?
  city             String?
  state            String?
  zipCode          String?
  emergencyContact String?
  emergencyPhone   String?
  allergies        String?
  medicalHistory   String?
  status           PatientStatus @default(ACTIVE)
  blockReason      String?
  documents        String[]      @default([])
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  appointments Appointment[]

  @@map("patients")
}

model Doctor {
  id          String   @id @default(uuid())
  userId      String   @unique
  crm         String   @unique
  crmUf       String
  sectorId    String?
  specialties String[]
  phone       String?
  address     String?
  city        String?
  state       String?
  zipCode     String?
  documents   String[] @default([])
  bio         String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  sector       Sector?       @relation(fields: [sectorId], references: [id], onDelete: SetNull)
  appointments Appointment[]

  @@map("doctors")
}

model Nurse {
  id        String   @id @default(uuid())
  userId    String   @unique
  coren     String   @unique
  corenUf   String
  sectorId  String?
  shift     String?
  phone     String?
  address   String?
  city      String?
  state     String?
  zipCode   String?
  documents String[] @default([])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  sector Sector? @relation(fields: [sectorId], references: [id], onDelete: SetNull)

  @@map("nurses")
}

model Sector {
  id          String   @id @default(uuid())
  name        String   @unique
  code        String   @unique
  description String?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  doctors Doctor[]
  nurses  Nurse[]

  @@map("sectors")
}

model Appointment {
  id              String            @id @default(uuid())
  patientId       String
  doctorId        String
  appointmentDate DateTime
  status          AppointmentStatus @default(AGENDADA)
  type            AppointmentType   @default(PRIMEIRA_CONSULTA)
  notes           String?
  diagnosis       String?
  prescription    String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  patient Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)
  doctor  Doctor  @relation(fields: [doctorId], references: [id], onDelete: Cascade)

  @@map("appointments")
}

model CommunicationEntry {
  id          String            @id @default(uuid())
  type        CommunicationType
  tag         String?
  title       String
  description String
  dateLabel   String?
  active      Boolean           @default(true)
  publishAt   DateTime          @default(now())
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@unique([type, title])
  @@map("communication_entries")
}

model InternalEmail {
  id        String   @id @default(uuid())
  sender    String
  subject   String
  preview   String
  body      String?
  timeLabel String?
  unread    Boolean  @default(true)
  active    Boolean  @default(true)
  sentAt    DateTime @default(now())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([sender, subject])
  @@map("internal_emails")
}
