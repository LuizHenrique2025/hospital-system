generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  MEDICO
  ENFERMEIRO
  ATENDENTE
  FARMACIA
  ESTOQUE
  FATURAMENTO
}

enum Gender {
  MASCULINO
  FEMININO
  OUTRO
}

enum BloodType {
  A_POSITIVO
  A_NEGATIVO
  B_POSITIVO
  B_NEGATIVO
  AB_POSITIVO
  AB_NEGATIVO
  O_POSITIVO
  O_NEGATIVO
}

enum PatientStatus {
  ACTIVE
  BLOCKED
  INACTIVE
}

enum AppointmentStatus {
  AGENDADA
  CONFIRMADA
  REALIZADA
  CANCELADA
  NAO_COMPARECEU
}

enum AppointmentType {
  PRIMEIRA_CONSULTA
  RETORNO
  URGENCIA
  EXAME
}

enum CommunicationType {
  UPDATE
  NOTICE
  HOLIDAY
}

enum InternalMessagePriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum ProcedureType {
  PROCEDURE
  LAB_EXAM
  IMAGE_EXAM
  CONSULTATION
  SURGERY
  ROOM_FEE
  PACKAGE
}

enum ExamOrderStatus {
  REQUESTED
  AUTHORIZATION_PENDING
  AUTHORIZED
  IN_PROGRESS
  RESULT_READY
  CANCELED
}

enum PricingTableType {
  CBHPM
  AGREEMENT
  OWN
  OPERATIONAL_FEE
  MATERIAL_MEDICATION
}

enum AuditAction {
  READ
  CREATE
  UPDATE
  DELETE
}

enum BillingGuideStatus {
  OPEN
  AUTHORIZATION_PENDING
  AUTHORIZED
  PARTIALLY_AUTHORIZED
  DENIED
  IN_EXECUTION
  EXECUTED
  ACCOUNT_REVIEW
  SENT_TO_PROVIDER
  PAID
  PARTIALLY_PAID
  GLOSA
  PENDING_DOCUMENTATION
  REJECTED
  APPEAL_IN_PROGRESS
  APPEAL_ACCEPTED
  APPEAL_DENIED
  LOSS_ACCEPTED
  CLOSED
  CANCELED
}

enum BillingGuideMovementType {
  OPENED
  STATUS_CHANGED
  AUTHORIZATION_REQUESTED
  AUTHORIZED
  DENIED
  EXECUTION_RECORDED
  ACCOUNT_REVIEW
  SENT_TO_PROVIDER
  PROVIDER_RETURN
  GLOSA_RECORDED
  APPEAL_CREATED
  APPEAL_RETURN
  DOCUMENT_ATTACHED
  CLOSED
  CANCELED
  COMMENT
}

enum BillingGuideItemStatus {
  REQUESTED
  AUTHORIZATION_PENDING
  AUTHORIZED
  PARTIALLY_AUTHORIZED
  DENIED
  EXECUTED
  BILLED
  GLOSA
  APPEALED
  PAID
  CANCELED
}

enum BudgetEstimateStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  CONVERTED
  CANCELED
  EXPIRED
}

model User {
  id        String   @id @default(uuid())
  name      String
  username  String   @unique
  email     String   @unique
  password  String
  role      Role     @default(ATENDENTE)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  doctor                   Doctor?
  nurse                    Nurse?
  sentInternalMessages     InternalMessage[]      @relation("SentInternalMessages")
  receivedInternalMessages InternalMessage[]      @relation("ReceivedInternalMessages")
  auditLogs                AuditLog[]
  createdBillingGuides     BillingGuide[]         @relation("CreatedBillingGuides")
  updatedBillingGuides     BillingGuide[]         @relation("UpdatedBillingGuides")
  guideMovements           BillingGuideMovement[] @relation("BillingGuideMovementResponsible")
  createdBudgetEstimates   BudgetEstimate[]       @relation("CreatedBudgetEstimates")
  approvedBudgetEstimates  BudgetEstimate[]       @relation("ApprovedBudgetEstimates")
}

model Patient {
  id               String        @id @default(uuid())
  name             String
  cpf              String        @unique
  rg               String?
  birthDate        DateTime
  gender           Gender
  bloodType        BloodType?
  phone            String
  email            String?
  address          String?
  city             String?
  state            String?
  zipCode          String?
  emergencyContact String?
  emergencyPhone   String?
  allergies        String?
  medicalHistory   String?
  status           PatientStatus @default(ACTIVE)
  blockReason      String?
  documents        String[]      @default([])
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  appointments    Appointment[]
  examOrders      ExamOrder[]
  billingGuides   BillingGuide[]
  budgetEstimates BudgetEstimate[]

  @@index([name])
  @@index([phone])
  @@index([status, createdAt])
  @@map("patients")
}

model Doctor {
  id          String   @id @default(uuid())
  userId      String   @unique
  crm         String   @unique
  crmUf       String
  sectorId    String?
  specialties String[]
  phone       String?
  address     String?
  city        String?
  state       String?
  zipCode     String?
  documents   String[] @default([])
  bio         String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  sector       Sector?       @relation(fields: [sectorId], references: [id], onDelete: SetNull)
  appointments Appointment[]
  examOrders   ExamOrder[]

  @@map("doctors")
}

model Nurse {
  id        String   @id @default(uuid())
  userId    String   @unique
  coren     String   @unique
  corenUf   String
  sectorId  String?
  shift     String?
  phone     String?
  address   String?
  city      String?
  state     String?
  zipCode   String?
  documents String[] @default([])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  sector Sector? @relation(fields: [sectorId], references: [id], onDelete: SetNull)

  @@map("nurses")
}

model Sector {
  id          String   @id @default(uuid())
  name        String   @unique
  code        String   @unique
  description String?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  doctors Doctor[]
  nurses  Nurse[]

  @@map("sectors")
}

model Appointment {
  id              String            @id @default(uuid())
  patientId       String
  doctorId        String
  appointmentDate DateTime
  status          AppointmentStatus @default(AGENDADA)
  type            AppointmentType   @default(PRIMEIRA_CONSULTA)
  notes           String?
  diagnosis       String?
  prescription    String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  patient       Patient        @relation(fields: [patientId], references: [id], onDelete: Cascade)
  doctor        Doctor         @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  examOrders    ExamOrder[]
  billingGuides BillingGuide[]

  @@map("appointments")
}

model CommunicationEntry {
  id          String            @id @default(uuid())
  type        CommunicationType
  tag         String?
  title       String
  description String
  dateLabel   String?
  active      Boolean           @default(true)
  publishAt   DateTime          @default(now())
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@unique([type, title])
  @@map("communication_entries")
}

model InternalEmail {
  id        String   @id @default(uuid())
  sender    String
  subject   String
  preview   String
  body      String?
  timeLabel String?
  unread    Boolean  @default(true)
  active    Boolean  @default(true)
  sentAt    DateTime @default(now())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([sender, subject])
  @@map("internal_emails")
}

model InternalMessage {
  id                  String                  @id @default(uuid())
  senderId            String
  recipientId         String
  subject             String
  body                String
  priority            InternalMessagePriority @default(NORMAL)
  readAt              DateTime?
  archivedBySender    Boolean                 @default(false)
  archivedByRecipient Boolean                 @default(false)
  deletedBySender     Boolean                 @default(false)
  deletedByRecipient  Boolean                 @default(false)
  createdAt           DateTime                @default(now())
  updatedAt           DateTime                @updatedAt

  sender    User @relation("SentInternalMessages", fields: [senderId], references: [id])
  recipient User @relation("ReceivedInternalMessages", fields: [recipientId], references: [id])

  @@index([recipientId, createdAt])
  @@index([senderId, createdAt])
  @@index([recipientId, readAt])
  @@map("internal_messages")
}

model HealthInsuranceProvider {
  id        String   @id @default(uuid())
  name      String   @unique
  code      String   @unique
  active    Boolean  @default(true)
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  pricingRules    AgreementPricingRule[]
  billingGuides   BillingGuide[]
  budgetEstimates BudgetEstimate[]

  @@map("health_insurance_providers")
}

model Procedure {
  id                    String               @id @default(uuid())
  code                  String               @unique
  description           String
  type                  ProcedureType        @default(PROCEDURE)
  tableCode             String?
  groupName             String?
  unit                  String?
  referencePriceCents   Int?
  requiresAuthorization Boolean              @default(false)
  requiresReport        Boolean              @default(false)
  billable              Boolean              @default(true)
  active                Boolean              @default(true)
  notes                 String?
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt
  examOrderItems        ExamOrderItem[]
  prices                ProcedurePrice[]
  billingGuideItems     BillingGuideItem[]
  budgetEstimateItems   BudgetEstimateItem[]

  @@map("procedures")
}

model PricingTable {
  id          String           @id @default(uuid())
  name        String
  type        PricingTableType @default(OWN)
  year        Int?
  code        String?
  description String?
  active      Boolean          @default(true)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  prices              ProcedurePrice[]
  agreementRules      AgreementPricingRule[]
  billingGuideItems   BillingGuideItem[]
  budgetEstimateItems BudgetEstimateItem[]

  @@unique([name, year])
  @@map("pricing_tables")
}

model AgreementPricingRule {
  id                    String    @id @default(uuid())
  providerId            String
  pricingTableId        String
  multiplierBasisPoints Int       @default(10000)
  requiresAuthorization Boolean   @default(false)
  active                Boolean   @default(true)
  validFrom             DateTime?
  validTo               DateTime?
  notes                 String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  provider     HealthInsuranceProvider @relation(fields: [providerId], references: [id], onDelete: Cascade)
  pricingTable PricingTable            @relation(fields: [pricingTableId], references: [id], onDelete: Restrict)

  @@unique([providerId, pricingTableId])
  @@index([providerId, active])
  @@index([pricingTableId])
  @@map("agreement_pricing_rules")
}

model ProcedurePrice {
  id                   String    @id @default(uuid())
  procedureId          String
  pricingTableId       String
  priceCents           Int
  operationalCostCents Int?
  billingUnit          String?
  effectiveFrom        DateTime?
  effectiveTo          DateTime?
  active               Boolean   @default(true)
  notes                String?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  procedure           Procedure            @relation(fields: [procedureId], references: [id], onDelete: Cascade)
  pricingTable        PricingTable         @relation(fields: [pricingTableId], references: [id], onDelete: Cascade)
  budgetEstimateItems BudgetEstimateItem[]

  @@unique([procedureId, pricingTableId])
  @@map("procedure_prices")
}

model CbhpmProcedure {
  id                         String   @id @default(uuid())
  codigo                     String
  procedimento               String
  porte                      String?
  fracaoPorte                Decimal? @db.Decimal(10, 4)
  valorPorteCents            Int?
  totalPorteCents            Int?
  incidencias                String?
  filme                      Decimal? @db.Decimal(10, 4)
  totalFilmeCents            Int?
  uco                        Decimal? @db.Decimal(10, 4)
  totalUcoCents              Int?
  porteAnestesico            String?
  valorPorteAnestesicoCents  Int?
  totalPorteAnestesicoCents  Int?
  numeroAuxiliares           Int?
  totalAuxiliaresCents       Int?
  totalPrimeiroAuxiliarCents Int?
  totalSegundoAuxiliarCents  Int?
  totalTerceiroAuxiliarCents Int?
  totalQuartoAuxiliarCents   Int?
  adicionaisCents            Int?
  subtotalCents              Int?
  editionYear                Int
  sourceFile                 String?
  importedAt                 DateTime @default(now())
  createdAt                  DateTime @default(now())
  updatedAt                  DateTime @updatedAt

  @@unique([codigo, editionYear])
  @@index([editionYear])
  @@index([sourceFile])
  @@map("cbhpm_procedures")
}

model ExamOrder {
  id                 String          @id @default(uuid())
  patientId          String
  requesterDoctorId  String?
  appointmentId      String?
  status             ExamOrderStatus @default(REQUESTED)
  priority           String?
  clinicalIndication String?
  notes              String?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  patient         Patient         @relation(fields: [patientId], references: [id], onDelete: Cascade)
  requesterDoctor Doctor?         @relation(fields: [requesterDoctorId], references: [id], onDelete: SetNull)
  appointment     Appointment?    @relation(fields: [appointmentId], references: [id], onDelete: SetNull)
  items           ExamOrderItem[]

  @@map("exam_orders")
}

model ExamOrderItem {
  id          String          @id @default(uuid())
  examOrderId String
  procedureId String
  quantity    Int             @default(1)
  status      ExamOrderStatus @default(REQUESTED)
  notes       String?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  examOrder ExamOrder @relation(fields: [examOrderId], references: [id], onDelete: Cascade)
  procedure Procedure @relation(fields: [procedureId], references: [id], onDelete: Restrict)

  @@unique([examOrderId, procedureId])
  @@map("exam_order_items")
}

model BillingGuide {
  id                    String             @id @default(uuid())
  guideNumber           String             @unique
  authorizationCode     String?
  patientId             String
  appointmentId         String?
  providerId            String?
  currentStatus         BillingGuideStatus @default(OPEN)
  originSector          String?
  careType              String?
  requestedAmountCents  Int                @default(0)
  authorizedAmountCents Int                @default(0)
  paidAmountCents       Int                @default(0)
  deniedAmountCents     Int                @default(0)
  appealedAmountCents   Int                @default(0)
  notes                 String?
  openedAt              DateTime           @default(now())
  closedAt              DateTime?
  createdById           String?
  updatedById           String?
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt

  patient              Patient                  @relation(fields: [patientId], references: [id], onDelete: Restrict)
  appointment          Appointment?             @relation(fields: [appointmentId], references: [id], onDelete: SetNull)
  provider             HealthInsuranceProvider? @relation(fields: [providerId], references: [id], onDelete: SetNull)
  createdBy            User?                    @relation("CreatedBillingGuides", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy            User?                    @relation("UpdatedBillingGuides", fields: [updatedById], references: [id], onDelete: SetNull)
  items                BillingGuideItem[]
  movements            BillingGuideMovement[]
  sourceBudgetEstimate BudgetEstimate?

  @@index([patientId, createdAt])
  @@index([appointmentId])
  @@index([providerId, currentStatus])
  @@index([currentStatus, updatedAt])
  @@map("billing_guides")
}

model BillingGuideItem {
  id                    String                 @id @default(uuid())
  guideId               String
  procedureId           String
  pricingTableId        String?
  quantity              Int                    @default(1)
  status                BillingGuideItemStatus @default(REQUESTED)
  requestedAmountCents  Int                    @default(0)
  authorizedAmountCents Int?
  deniedAmountCents     Int?
  paidAmountCents       Int?
  notes                 String?
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt

  guide        BillingGuide  @relation(fields: [guideId], references: [id], onDelete: Cascade)
  procedure    Procedure     @relation(fields: [procedureId], references: [id], onDelete: Restrict)
  pricingTable PricingTable? @relation(fields: [pricingTableId], references: [id], onDelete: SetNull)

  @@index([guideId])
  @@index([procedureId])
  @@index([pricingTableId])
  @@index([status])
  @@map("billing_guide_items")
}

model BillingGuideMovement {
  id                String                   @id @default(uuid())
  guideId           String
  movementType      BillingGuideMovementType @default(STATUS_CHANGED)
  fromStatus        BillingGuideStatus?
  toStatus          BillingGuideStatus
  sector            String?
  responsibleUserId String?
  reason            String?
  notes             String?
  amountCents       Int?
  metadata          Json?
  createdAt         DateTime                 @default(now())

  guide           BillingGuide @relation(fields: [guideId], references: [id], onDelete: Cascade)
  responsibleUser User?        @relation("BillingGuideMovementResponsible", fields: [responsibleUserId], references: [id], onDelete: SetNull)

  @@index([guideId, createdAt])
  @@index([responsibleUserId, createdAt])
  @@index([toStatus, createdAt])
  @@index([sector, createdAt])
  @@map("billing_guide_movements")
}

model BudgetEstimate {
  id               String               @id @default(uuid())
  code             String               @unique
  patientId        String?
  providerId       String?
  status           BudgetEstimateStatus @default(DRAFT)
  title            String?
  notes            String?
  subtotalCents    Int                  @default(0)
  discountCents    Int                  @default(0)
  totalCents       Int                  @default(0)
  approvedAt       DateTime?
  expiresAt        DateTime?
  convertedGuideId String?              @unique
  createdById      String?
  approvedById     String?
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt

  patient        Patient?                 @relation(fields: [patientId], references: [id], onDelete: SetNull)
  provider       HealthInsuranceProvider? @relation(fields: [providerId], references: [id], onDelete: SetNull)
  convertedGuide BillingGuide?            @relation(fields: [convertedGuideId], references: [id], onDelete: SetNull)
  createdBy      User?                    @relation("CreatedBudgetEstimates", fields: [createdById], references: [id], onDelete: SetNull)
  approvedBy     User?                    @relation("ApprovedBudgetEstimates", fields: [approvedById], references: [id], onDelete: SetNull)
  items          BudgetEstimateItem[]

  @@index([patientId, createdAt])
  @@index([providerId, status])
  @@index([status, updatedAt])
  @@map("budget_estimates")
}

model BudgetEstimateItem {
  id                   String   @id @default(uuid())
  estimateId           String
  procedureId          String
  pricingTableId       String?
  procedurePriceId     String?
  description          String
  quantity             Int      @default(1)
  unitPriceCents       Int      @default(0)
  operationalCostCents Int?
  discountCents        Int      @default(0)
  totalCents           Int      @default(0)
  notes                String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  estimate       BudgetEstimate  @relation(fields: [estimateId], references: [id], onDelete: Cascade)
  procedure      Procedure       @relation(fields: [procedureId], references: [id], onDelete: Restrict)
  pricingTable   PricingTable?   @relation(fields: [pricingTableId], references: [id], onDelete: SetNull)
  procedurePrice ProcedurePrice? @relation(fields: [procedurePriceId], references: [id], onDelete: SetNull)

  @@index([estimateId])
  @@index([procedureId])
  @@index([pricingTableId])
  @@index([procedurePriceId])
  @@map("budget_estimate_items")
}

model AuditLog {
  id         String      @id @default(uuid())
  actorId    String?
  actorRole  Role?
  action     AuditAction
  resource   String
  resourceId String?
  route      String
  method     String
  ipAddress  String?
  userAgent  String?
  statusCode Int?
  metadata   Json?
  createdAt  DateTime    @default(now())

  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([actorId, createdAt])
  @@index([action, createdAt])
  @@index([resource, resourceId])
  @@map("audit_logs")
}
